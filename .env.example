# Server
PORT=8080
FRONTEND_DIR=./frontend
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gifted_hands?sslmode=disable

# Auth
JWT_SECRET=@MY-SECRET-KEY@
ADMIN_SESSION_HOURS=24

# Business contact (used by frontend config generation if needed)
BUSINESS_PHONE=0719838328
WHATSAPP_PHONE=254719838328

# Booking notifications (leave blank to disable)
NOTIFY_EMAIL=you@example.com
NOTIFY_PHONE=+254712345678

# Email via SMTP (Gmail example: smtp.gmail.com:587 + app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
SMTP_FROM=you@example.com

# Email via Gmail API (recommended on Render; HTTPS/443 instead of blocked SMTP ports)
# Generate GMAIL_REFRESH_TOKEN with: go run ./backend/cmd/gmailauth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=http://localhost:8080/oauth2/callback

# SMS: SMS_PROVIDER=africastalking, twilio or textbee
SMS_PROVIDER=africastalking
AT_USERNAME=sandbox
AT_API_KEY=your-africastalking-api-key
AT_SENDER=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# textbee free tier: 300 SMS/month via your own Android phone and SIM
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
